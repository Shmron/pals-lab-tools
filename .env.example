# Copy to .env and fill in real values. NEVER commit the real .env file.
# Variable names below were detected from the code; each tool's README lists the ones it uses.

# Shared by the atlas, PALs Earth and the catalogue assistant. core/apikey.py reads it from the environment (or an env file you point it at).
ANTHROPIC_API_KEY=

# --- PALs Earth ---
PALSEARTH_COOKIE_SECURE=
PALSEARTH_HOST=
PALSEARTH_PREFIX=
PALSEARTH_RECOVER_JOBS=
PALSEARTH_ROOT=
PALSEARTH_SECRET_KEY=
PALSEARTH_STATE_DB=
SMTP_APP_PASSWORD=

# --- Harare Flood & Access Tool ---
EE_SA_EMAIL=
EE_SA_KEY=

# --- PRECISE Network Catalogue and API ---
CATALOGUE_ACCESS_CODE=
HE2AT_ACCESS_CODE=
WORKSHOP_KEY=

# --- Data Access Request Services ---
FLASK_SECRET_KEY=

# --- ECRI Poster Judging ---
POSTER_BASE_URL=
POSTER_CHIEF_PASSWORD=
POSTER_DB=
POSTER_PREFIX=
